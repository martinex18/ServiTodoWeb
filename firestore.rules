rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return request.auth.uid == userId; }

    match /categories/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /typeID/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /worker/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner(userId);
    }

    match /client/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner(userId);
    }

    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isSignedIn() && isOwner(resource.data.user_id);
    }

    match /requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.worker_id ||
        request.auth.uid == resource.data.client_id
      );
      allow delete: if false;
    } 
  }
}